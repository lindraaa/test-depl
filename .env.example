# Local Postgres (no SSL). For Supabase, use the URI from Project Settings → Database.
# App: session pooler is fine. Migrations: prefer the direct (db.<ref>.supabase.co:5432) URI.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vet_db"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
AUTH_GOOGLE_REDIRECT_URLS="http://localhost:5173/auth/callback"
PORT=3000
FRONTEND_URL="http://localhost:5173"
